# kovanica-web environment. Copy to .env (never commit .env).
# Use DNS names only — never IP addresses, keys or secrets in this file.

# --- Public network config (inlined into the client bundle at build time) ---
# Bootstrap seeds clones dial, comma separated host:port.
KOVANICA_PUBLIC_SEED_PEERS=seed1.kovanica.online:8000
# P2P TCP port shown in docs/operator instructions.
KOVANICA_PUBLIC_P2P_PORT=8000
# Optional public JSON-RPC WebSocket endpoint (wss://...) for live Explorer DAG streaming.
# Leave blank to use HTTP polling by default.
KOVANICA_PUBLIC_WS_URL=

# --- Server-only (never exposed to the browser) ---
# Upstream of the co-located Rust node's HTTP API. Leave blank to use the
# loopback default in code; set a DNS name here if the node lives elsewhere.
KOVANICA_NODE_API_URL=

# Public kovanica-testnet (chain ID 2) JSON-RPC. DNS name only.
# Anonymous reads; writes answer HTTP 401 on the public RPC. Never add a token.
KOVANICA_RPC_URL=https://rpc-testnet.kovanica.online/rpc
# Optional faucet service. Blank = the faucet shows "unavailable".
# Use a DNS name, or a loopback URL when the faucet runs on this same host
# (e.g. http://127.0.0.1:3000/faucet). Server-side only — the browser never
# talks to this URL and it is never inlined into the client bundle.
KOVANICA_FAUCET_URL=
# Trust the reverse proxy's client-IP headers (X-Real-IP, then the last hop of
# X-Forwarded-For) and forward that address to the faucet, which rate-limits per
# IP. Safe because this app listens on loopback behind nginx. Set to 0 only if
# the app itself is exposed to the internet: the headers are then ignored and the
# faucet keys every caller on this server's address.
KOVANICA_TRUST_PROXY_HEADERS=1

# --- Auth (server-only; leave blank unless sign-in is enabled) ---
# "false" turns sign-in off everywhere (also inlined into the client at build).
VITE_AUTH_ENABLED=false
# Per-app OAuth client at the auth broker. Values come from the broker, never from git.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# Live-preview-only shared client secret (*.grok-sandbox.com). Not needed on the VPS.
GROK_PREVIEW_CLIENT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=

# --- Billing & API Key Provisioning (server-only; all optional) ---
# Leave secrets blank in .env.example. When STRIPE_SECRET_KEY is unset,
# /api/billing/checkout automatically serves structured on-chain USDC/KVNC invoices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_RWA_STARTER=
STRIPE_PRICE_RWA_ENTERPRISE=
# Bearer token required for admin API key endpoints (/api/keys).
BILLING_ADMIN_TOKEN=
# Treasury address displayed on on-chain KVNC/USDC invoices.
BILLING_TREASURY_ADDRESS=
# Optional indicative USD price per KVNC for KVNC-denominated invoices (default 0.10).
BILLING_KVNC_USD_RATE=
