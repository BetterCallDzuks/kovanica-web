# Kovanica Protocol — Mainnet Chain 1 RPC Nginx Cutover Template (`rpc.kovanica.online`)
#
# Deployment instructions (1.1.2027 Mainnet Cutover):
#   1. Copy to /etc/nginx/sites-available/rpc.kovanica.online
#   2. Replace __KOVANICA_RPC_WRITE_TOKEN__ with the production secret from your vault
#      (or inject via an include file readable only by root: /etc/nginx/snippets/kovanica-write-token.conf).
#   3. Provision origin TLS cert:
#        sudo certbot certonly --nginx -d rpc.kovanica.online
#   4. Validate & enable:
#        sudo ln -s /etc/nginx/sites-available/rpc.kovanica.online /etc/nginx/sites-enabled/rpc.kovanica.online
#        sudo nginx -t && sudo systemctl reload nginx
#
# Architecture notes:
#   - Mainnet public RPC hostname is locked to `rpc.kovanica.online` (Cloudflare Full Strict).
#   - Read-only JSON-RPC (`POST /rpc`) is rate-limited for public traffic.
#   - Authenticated write JSON-RPC (`POST /rpc/write`) requires `Authorization: Bearer <KOVANICA_RPC_WRITE_TOKEN>`
#     and forwards the token to the Kovanica L1 node's `KOVANICA_RPC_WRITE_TOKEN` guard.
#   - WebSocket subscriptions (`GET /ws`) support HTTP/1.1 Upgrade with dedicated connection limits.

# --- Connection upgrade map for WebSockets ------------------------------------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- Bearer token gate for authenticated write RPC ----------------------------
# Replace __KOVANICA_RPC_WRITE_TOKEN__ with the real token (must match node KOVANICA_RPC_WRITE_TOKEN).
map $http_authorization $kovanica_rpc_write_authorized {
    default 0;
    "Bearer __KOVANICA_RPC_WRITE_TOKEN__" 1;
}

# --- Rate-limiting & connection-limiting zones --------------------------------
# Public read-only JSON-RPC: 30 req/s steady per client IP (burst 60).
limit_req_zone  $binary_remote_addr zone=kvnc_rpc_read:20m   rate=30r/s;
# Authenticated write JSON-RPC: 10 req/s steady per client IP (burst 20).
limit_req_zone  $binary_remote_addr zone=kvnc_rpc_write:10m  rate=10r/s;
# WebSocket handshake rate & concurrent connections per IP.
limit_req_zone  $binary_remote_addr zone=kvnc_ws_open:10m    rate=5r/s;
limit_conn_zone $binary_remote_addr zone=kvnc_ws_conn:10m;

# --- Mainnet Chain 1 L1 RPC upstream ------------------------------------------
upstream kovanica_mainnet_rpc {
    # Primary local Mainnet Chain 1 node on seed1
    server 127.0.0.1:8545 max_fails=3 fail_timeout=15s;
    # Optional warm standby / observer node:
    # server 127.0.0.1:8546 backup;
    keepalive 64;
}

# --- HTTP -> HTTPS permanent redirect -----------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name rpc.kovanica.online;

    # Allow ACME HTTP-01 renewal challenges
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS (443) Mainnet RPC & WebSocket Endpoint -----------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rpc.kovanica.online;

    # Origin TLS certificates (Let's Encrypt / Cloudflare Full Strict)
    ssl_certificate     /etc/letsencrypt/live/rpc.kovanica.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rpc.kovanica.online/privkey.pem;

    # Modern TLS configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:KVNC_RPC_SSL:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Production security & HSTS headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Strict payload limit for JSON-RPC requests
    client_max_body_size 1m;
    server_tokens off;

    # Structured access & error logs
    access_log /var/log/nginx/rpc.kovanica.online.access.log;
    error_log  /var/log/nginx/rpc.kovanica.online.error.log warn;

    # 1. Lightweight health probe (for synthetic monitors & Cloudflare checks)
    location = /health {
        proxy_pass http://kovanica_mainnet_rpc/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    # 2. Public Read-Only JSON-RPC (`POST /rpc`)
    # Strips any caller-supplied Authorization header so public traffic cannot
    # reach write-privileged node methods on the read-only route.
    location = /rpc {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        limit_except POST OPTIONS {
            deny all;
        }

        limit_req zone=kvnc_rpc_read burst=60 nodelay;
        limit_req_status 429;

        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;

        proxy_pass http://kovanica_mainnet_rpc/rpc;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Explicitly clear Authorization on the public read-only route
        proxy_set_header Authorization "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }

    # 3. Bearer-Authenticated Write JSON-RPC (`POST /rpc/write`)
    # Requires `Authorization: Bearer <KOVANICA_RPC_WRITE_TOKEN>` before
    # forwarding to the L1 node's write-protected JSON-RPC handler.
    location = /rpc/write {
        limit_except POST {
            deny all;
        }

        if ($kovanica_rpc_write_authorized = 0) {
            add_header Content-Type "application/json" always;
            return 401 '{"jsonrpc":"2.0","id":null,"error":{"code":-32001,"message":"Unauthorized: valid KOVANICA_RPC_WRITE_TOKEN bearer token required"}}';
        }

        limit_req zone=kvnc_rpc_write burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://kovanica_mainnet_rpc/rpc;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;

        proxy_connect_timeout 5s;
        proxy_send_timeout 20s;
        proxy_read_timeout 30s;
    }

    # 4. WebSocket Subscriptions (`GET /ws`)
    location = /ws {
        limit_req zone=kvnc_ws_open burst=10 nodelay;
        limit_conn kvnc_ws_conn 16;

        proxy_pass http://kovanica_mainnet_rpc/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Reject all other paths with clean JSON 404
    location / {
        default_type application/json;
        return 404 '{"error":"not_found","endpoints":["/rpc","/rpc/write","/ws","/health"]}';
    }
}
